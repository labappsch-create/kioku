rules_version = '2';

// Reglas de seguridad de Kioku (ver docs/decisiones.md).
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Ayudas ----------

    function conCuenta() {
      return request.auth != null;
    }

    function esDueno(uid) {
      return conCuenta() && request.auth.uid == uid;
    }

    // Administrador principal: labappsch@gmail.com. Más los que nombre.
    function esAdmin() {
      return conCuenta()
        && (request.auth.token.get('email', '') == 'labappsch@gmail.com'
            || exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function esOrganizador() {
      return conCuenta()
        && exists(/databases/$(database)/documents/organizadores/$(request.auth.uid));
    }

    function esEntrenador() {
      let yo = get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
      return yo.get('rol', '') in ['entrenador', 'ambos'];
    }

    function esSenseiDe(dojoId) {
      return conCuenta()
        && get(/databases/$(database)/documents/dojos/$(dojoId)).data.senseiUid == request.auth.uid;
    }

    function esOrganizadorDe(cid) {
      return conCuenta()
        && get(/databases/$(database)/documents/competencias/$(cid)).data.organizadorUid == request.auth.uid;
    }

    function cambioDeConteo(cid, catId) {
      let antes = resource.data.get('inscritos', 0);
      let despues = request.resource.data.inscritos;
      let iid = request.resource.data.ultimaInscripcion;
      return conCuenta()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['inscritos', 'ultimaInscripcion'])
        && iid is string
        && ((despues == antes + 1
             && !exists(/databases/$(database)/documents/inscripciones/$(iid))
             && existsAfter(/databases/$(database)/documents/inscripciones/$(iid))
             && getAfter(/databases/$(database)/documents/inscripciones/$(iid)).data.competenciaId == cid
             && getAfter(/databases/$(database)/documents/inscripciones/$(iid)).data.categoriaId == catId)
          || (despues == antes - 1
             && exists(/databases/$(database)/documents/inscripciones/$(iid))
             && !existsAfter(/databases/$(database)/documents/inscripciones/$(iid))
             && get(/databases/$(database)/documents/inscripciones/$(iid)).data.competenciaId == cid
             && get(/databases/$(database)/documents/inscripciones/$(iid)).data.categoriaId == catId));
    }

    function inscripcionValida(iid, d) {
      let comp = get(/databases/$(database)/documents/competencias/$(d.competenciaId)).data;
      return iid == d.competenciaId + '_' + d.atletaUid + '_' + d.modalidad
        && d.estado == 'pendiente'
        && d.inscritoPor == request.auth.uid
        && (request.auth.uid == d.atletaUid || request.auth.uid == d.senseiUid)
        // Solo atletas con dojo confirmado; el sensei es el de ese dojo.
        && get(/databases/$(database)/documents/dojos/$(d.dojoId)).data.senseiUid == d.senseiUid
        && get(/databases/$(database)/documents/dojos/$(d.dojoId)/miembros/$(d.atletaUid)).data.estado == 'confirmado'
        && d.atletaNombre == get(/databases/$(database)/documents/perfiles/$(d.atletaUid)).data.nombreMostrado
        // Inscripciones abiertas.
        && comp.organizadorUid == d.organizadorUid
        && comp.get('cerradaAntes', false) == false
        && comp.get('situacion', 'normal') == 'normal'
        && request.time < comp.cierre
        // La categoría existe, es de esa modalidad y su conteo sube en 1.
        && get(/databases/$(database)/documents/competencias/$(d.competenciaId)/categorias/$(d.categoriaId)).data.modalidad == d.modalidad
        && getAfter(/databases/$(database)/documents/competencias/$(d.competenciaId)/categorias/$(d.categoriaId)).data.inscritos
             == get(/databases/$(database)/documents/competencias/$(d.competenciaId)/categorias/$(d.categoriaId)).data.inscritos + 1;
    }

    function puedeAnular(i) {
      let comp = get(/databases/$(database)/documents/competencias/$(i.competenciaId)).data;
      return comp.get('situacion', 'normal') == 'normal'
        && (i.estado == 'pendiente'
            || (comp.get('anularHasta', null) != null
                && request.time < comp.anularHasta));
    }

    // Grupo de edad del ranking. Debe coincidir con lib/datos/puntos.dart.
    function grupoDe(edad) {
      return edad <= 11 ? 'infantil'
        : (edad <= 17 ? 'juvenil'
        : (edad <= 39 ? 'adultos' : 'senior'));
    }

    // Organizador: desde el primer día hasta 30 días después del último.
    // Administrador: desde el primer día, sin límite.
    function puedeCargarResultados(cid) {
      let comp = get(/databases/$(database)/documents/competencias/$(cid)).data;
      return conCuenta()
        && comp.get('situacion', 'normal') == 'normal'
        && request.time >= comp.fechaInicio
        && ((comp.organizadorUid == request.auth.uid
             && request.time < comp.fechaFin + duration.value(31, 'd'))
            || esAdmin());
    }

    function podioValido(pid, d) {
      let insc = get(/databases/$(database)/documents/inscripciones/$(d.iid)).data;
      let comp = get(/databases/$(database)/documents/competencias/$(d.competenciaId)).data;
      return d.puesto in [1, 2, 3, 4]
        && pid == d.competenciaId + '_' + d.categoriaId + '_' + string(d.puesto)
        && insc.estado == 'confirmada'
        && insc.competenciaId == d.competenciaId
        && insc.categoriaId == d.categoriaId
        && insc.atletaUid == d.atletaUid
        && insc.atletaNombre == d.atletaNombre
        && insc.dojoId == d.dojoId
        && insc.dojoNombre == d.dojoNombre
        && insc.modalidad == d.modalidad
        && insc.sexo == d.sexo
        && d.grupo == grupoDe(insc.edad)
        && d.nivel == comp.nivel
        && d.pais == comp.pais
        && d.region == comp.region
        && d.anio == comp.fechaInicio.year();
    }

    // El historial lo escribe el propio atleta: solo competencias
    // confirmadas, no canceladas, y el puesto debe existir en los podios.
    function historialValido(uid, iid, d) {
      let insc = get(/databases/$(database)/documents/inscripciones/$(iid)).data;
      return insc.atletaUid == uid
        && insc.estado == 'confirmada'
        && get(/databases/$(database)/documents/competencias/$(insc.competenciaId)).data.get('situacion', 'normal') != 'cancelada'
        && (!('puesto' in d)
            || get(/databases/$(database)/documents/podios/$(insc.competenciaId + '_' + insc.categoriaId + '_' + string(d.puesto))).data.iid == iid);
    }

    // ---------- Perfiles ----------

    // Perfil completo (incluye fecha de nacimiento): solo su dueño.
    match /usuarios/{uid} {
      allow read, write: if esDueno(uid);

      // Avisos de torneos que ya vio.
      match /avisos_vistos/{cid} {
        allow read, write: if esDueno(uid);
      }
    }

    // Lo que ven los demás de una persona.
    match /perfiles/{uid} {
      allow read: if conCuenta();
      allow delete: if esDueno(uid);
      allow create, update: if esDueno(uid)
        // Nadie puede marcar su propio dojo como confirmado.
        && request.resource.data.dojoConfirmado == false
        // Menores de 18: solo nombre de pila, dojo y grado.
        && (request.resource.data.esMenor == false
            || request.resource.data.keys().hasOnly([
                 'esMenor', 'nombreMostrado', 'nombreBusqueda',
                 'gradoId', 'dojo', 'dojoId', 'dojoConfirmado', 'actualizado']));

      // Competencias en las que participó. Las ven otros solo si es adulto
      // y eligió mostrar su historial.
      match /historial/{iid} {
        allow read: if esDueno(uid)
          || (conCuenta()
              && get(/databases/$(database)/documents/perfiles/$(uid)).data.esMenor == false
              && get(/databases/$(database)/documents/perfiles/$(uid)).data.get('mostrarHistorial', false) == true);
        allow create, update: if esDueno(uid)
          && historialValido(uid, iid, request.resource.data);
        allow delete: if esDueno(uid);
      }
    }

    // ---------- Dojos ----------

    match /dojos/{dojoId} {
      allow read: if conCuenta();
      // Solo entrenadores crean dojos, y quedan como sensei a cargo.
      allow create: if conCuenta() && esEntrenador()
        && request.resource.data.senseiUid == request.auth.uid;
      // Solo el sensei a cargo lo edita, y no puede pasárselo a otro.
      allow update: if conCuenta()
        && resource.data.senseiUid == request.auth.uid
        && request.resource.data.senseiUid == request.auth.uid;

      // Solicitudes y miembros. El documento lleva el uid del practicante.
      match /miembros/{uid} {
        allow read: if conCuenta();
        // Solicitud pendiente, o el sensei confirmado en su propio dojo.
        allow create: if esDueno(uid)
          && (request.resource.data.estado == 'pendiente'
              || (request.resource.data.estado == 'confirmado'
                  && get(/databases/$(database)/documents/dojos/$(dojoId)).data.senseiUid == uid))
          && request.resource.data.keys().hasOnly(
               ['estado', 'nombreMostrado', 'gradoId', 'actualizado'])
          && request.resource.data.nombreMostrado
               == getAfter(/databases/$(database)/documents/perfiles/$(uid)).data.nombreMostrado;
        allow update: if (esSenseiDe(dojoId)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['estado', 'actualizado'])
            && request.resource.data.estado == 'confirmado')
          || (esDueno(uid)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['nombreMostrado', 'gradoId', 'actualizado'])
            && request.resource.data.nombreMostrado
                 == getAfter(/databases/$(database)/documents/perfiles/$(uid)).data.nombreMostrado);
        allow delete: if esDueno(uid) || esSenseiDe(dojoId);
      }

      // Datos para competir (edad, peso, estatura, sexo): solo el
      // practicante y el sensei del dojo.
      match /fichas/{uid} {
        allow read: if esDueno(uid) || esSenseiDe(dojoId);
        allow create, update: if esDueno(uid)
          && request.resource.data.keys().hasOnly(
               ['edad', 'pesoKg', 'estaturaCm', 'sexo', 'actualizado']);
        allow delete: if esDueno(uid) || esSenseiDe(dojoId);
      }
    }

    // Datos completos del dojo: solo su sensei.
    match /dojos_privados/{dojoId} {
      allow read: if conCuenta() && resource.data.senseiUid == request.auth.uid;
      allow create: if conCuenta() && esEntrenador()
        && request.resource.data.senseiUid == request.auth.uid;
      allow update: if conCuenta()
        && resource.data.senseiUid == request.auth.uid
        && request.resource.data.senseiUid == request.auth.uid;
    }

    // ---------- Administración ----------

    // El administrador principal se reconoce por su correo y no está en
    // esta lista, así que nadie puede quitarlo.
    match /admins/{uid} {
      allow read: if conCuenta();
      allow create: if esAdmin()
        && request.resource.data.keys().hasOnly(['nombre', 'creado']);
      allow delete: if esAdmin();
    }

    match /organizadores/{uid} {
      allow read: if conCuenta();
      allow create: if esAdmin()
        && request.resource.data.keys().hasOnly(['nombre', 'aprobado']);
      allow delete: if esAdmin();
    }

    match /solicitudes_organizador/{uid} {
      allow read: if esDueno(uid) || esAdmin();
      allow create: if esDueno(uid)
        && request.resource.data.keys().hasOnly(['nombre', 'mensaje', 'creado'])
        && request.resource.data.nombre
             == get(/databases/$(database)/documents/perfiles/$(uid)).data.nombreMostrado;
      // Rechazo: el administrador agrega el estado y el motivo.
      allow update: if esAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['estado', 'motivo', 'rechazado'])
        && request.resource.data.estado == 'rechazada'
        && request.resource.data.motivo is string
        && request.resource.data.motivo.size() > 0;
      allow delete: if esDueno(uid) || esAdmin();
    }

    // ---------- Competencias ----------

    match /competencias/{cid} {
      allow read: if conCuenta();
      // Locales: el sensei del dojo. Otros niveles: organizadores aprobados.
      allow create: if conCuenta()
        && request.resource.data.organizadorUid == request.auth.uid
        && request.resource.data.cerradaAntes == false
        && ((request.resource.data.nivel == 'local'
             && request.resource.data.dojoId is string
             && get(/databases/$(database)/documents/dojos/$(request.resource.data.dojoId)).data.senseiUid == request.auth.uid)
          || (request.resource.data.nivel in ['regional', 'nacional', 'internacional']
             && esOrganizador()));
      // Solo el organizador edita. No puede cambiar el nivel ni el dojo.
      // Cancelar es definitivo. Suspender y cancelar exigen motivo.
      allow update: if conCuenta()
        && resource.data.organizadorUid == request.auth.uid
        && request.resource.data.organizadorUid == request.auth.uid
        && request.resource.data.nivel == resource.data.nivel
        && request.resource.data.get('dojoId', null) == resource.data.get('dojoId', null)
        && resource.data.get('situacion', 'normal') != 'cancelada'
        && request.resource.data.get('situacion', 'normal') in ['normal', 'suspendida', 'cancelada']
        && (request.resource.data.get('situacion', 'normal') == 'normal'
            || (request.resource.data.get('motivo', '') is string
                && request.resource.data.get('motivo', '').size() > 0));

      match /categorias/{catId} {
        allow read: if conCuenta();
        allow create: if esOrganizadorDe(cid)
          && request.resource.data.inscritos == 0;
        // El organizador edita sin tocar el conteo. Cualquiera ajusta el
        // conteo en ±1 solo junto con su inscripción.
        allow update: if (esOrganizadorDe(cid)
            && request.resource.data.inscritos == resource.data.inscritos)
          || cambioDeConteo(cid, catId);
        allow delete: if esOrganizadorDe(cid) && resource.data.inscritos == 0;
      }
    }

    // ---------- Inscripciones ----------

    match /inscripciones/{iid} {
      // Las ven el atleta, su sensei y el organizador.
      allow read: if conCuenta()
        && (resource == null
            || resource.data.atletaUid == request.auth.uid
            || resource.data.senseiUid == request.auth.uid
            || resource.data.organizadorUid == request.auth.uid
            || esAdmin());
      allow create: if conCuenta() && inscripcionValida(iid, request.resource.data);
      // Solo el organizador confirma.
      allow update: if conCuenta()
        && resource.data.organizadorUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado'])
        && request.resource.data.estado == 'confirmada';
      // El organizador siempre. El atleta o su sensei, solo con el torneo
      // en situación normal y si sigue pendiente (o, tras reactivar un
      // torneo suspendido, hasta el nuevo cierre aunque esté confirmada).
      allow delete: if conCuenta()
        && (resource.data.organizadorUid == request.auth.uid
            || ((resource.data.atletaUid == request.auth.uid
                 || resource.data.senseiUid == request.auth.uid)
                && puedeAnular(resource.data)))
        && getAfter(/databases/$(database)/documents/competencias/$(resource.data.competenciaId)/categorias/$(resource.data.categoriaId)).data.inscritos
             == get(/databases/$(database)/documents/competencias/$(resource.data.competenciaId)/categorias/$(resource.data.categoriaId)).data.inscritos - 1;
    }

    // ---------- Resultados ----------

    match /podios/{pid} {
      allow read: if conCuenta();
      allow create, update: if puedeCargarResultados(request.resource.data.competenciaId)
        && podioValido(pid, request.resource.data);
      allow delete: if puedeCargarResultados(resource.data.competenciaId);
    }
  }
}
